# Copy to .env (never commit .env). Values come from Supabase: Project Settings > API Keys.
SUPABASE_URL=https://ktjvbajrfrbwpndforcy.supabase.co
# SERVER ONLY. Full database access: never put it in the frontend or in Git.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; callers of the HTTP API must send it as X-ML-Secret.
ML_WEBHOOK_SECRET=
# Optional
SIGLIP_MODEL=google/siglip-base-patch16-224
ML_DEVICE=
ML_BATCH_SIZE=16

# --- AI planner (POST /plan) ---
# Optional. With a key, Claude reads the user's request; without it a built-in rules parser does.
ANTHROPIC_API_KEY=
# Web app origins allowed to call the API (comma-separated). http://<LAN IP>:5173 is also allowed.
PLANNER_ALLOWED_ORIGINS=http://localhost:5173
# Optional: the public anon/publishable key, used to verify sign-in tokens (else the service key is used).
SUPABASE_ANON_KEY=
# Optional: "auto" (Claude if a key is set) or "rules" (never call Claude).
PLANNER_ENGINE=auto
# Optional: "nominatim" (OpenStreetMap lookups for unknown places) or "off" (known LA places only).
PLANNER_GEOCODER=nominatim
# DEV ONLY: 1 = /plan works without signing in. Leave empty everywhere else.
PLANNER_DEV_ALLOW_ANON=
