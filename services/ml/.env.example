# Copy to .env (never commit .env). Values come from Supabase: Project Settings > API Keys.
SUPABASE_URL=https://ktjvbajrfrbwpndforcy.supabase.co
# SERVER ONLY. Full database access: never put it in the frontend or in Git.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; callers of the HTTP API must send it as X-ML-Secret.
ML_WEBHOOK_SECRET=
# Optional
SIGLIP_MODEL=google/siglip-base-patch16-224
ML_DEVICE=
ML_BATCH_SIZE=16

# Optional: public (anon/publishable) key, used to check signed-in users' tokens for /ai/*
# (falls back to the service role key).
SUPABASE_ANON_KEY=
# Optional: browser origins for CORS (default http://localhost:5173 + http://<LAN IP>:5173).
ML_ALLOWED_ORIGINS=http://localhost:5173
# Optional AI photo tool limits (defaults shown).
AI_MAX_UPLOAD_MB=30
AI_MAX_PIXELS=50000000
AI_MAX_EDGE=2048
AI_UPSCALE_MAX_EDGE=1024
AI_RATE_LIMIT=30
AI_RATE_WINDOW_S=600
AI_QUEUE_TIMEOUT_S=60
AI_ORT_THREADS=0
AI_PRELOAD=1
