# Copy to mobile/.env and fill in (Supabase: Project Settings > API Keys).
# Only the project URL and the *publishable* key belong here (safe in a client app;
# Row-Level Security protects the data). Never put the service role / secret key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The ML service for the photo editor's AI tools (services/ml, docs/AI_TOOLS.md).
# On a phone use your computer's LAN address (same Wi-Fi), not localhost. Empty = AI tools off.
EXPO_PUBLIC_ML_URL=http://192.168.1.20:8000

# Studio, the layers editor (docs/STUDIO.md): the origin that serves frontend/public/studio/
# (the page is <this>/studio/index.html). In production this is the deployed web app's origin,
# e.g. https://photomatch.app. For development, the Vite dev server's LAN address or a tunnel
# to it (it must be https or reachable from the phone). Empty = the Studio buttons are off.
EXPO_PUBLIC_STUDIO_URL=https://your-web-app.example.com
