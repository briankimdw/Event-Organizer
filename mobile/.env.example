# Copy to mobile/.env and fill in (Supabase: Project Settings > API Keys).
# Only the project URL and the *publishable* key belong here (safe in a client app;
# Row-Level Security protects the data). Never put the service role / secret key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The AI planner service (services/ml, POST /plan). A phone can't reach "localhost" on your
# computer, so use the computer's LAN IP (ipconfig / ifconfig), e.g. http://192.168.1.20:8000.
# Leave empty to use the Expo dev server's host on port 8000 (works in Expo Go on the same Wi-Fi).
EXPO_PUBLIC_PLANNER_URL=
