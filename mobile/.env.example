# Copy to mobile/.env and fill in (Supabase: Project Settings > API Keys).
# Only the project URL and the *publishable* key belong here (safe in a client app;
# Row-Level Security protects the data). Never put the service role / secret key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
