{
  "expo": {
    "name": "photomatch",
    "slug": "event-organizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eventorganizer",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ffffff",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Find photographers and videographers who work near you or travel to you.",
        "NSPhotoLibraryUsageDescription": "Choose photos to post to your portfolio."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF0EB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find photographers and videographers who work near you or travel to you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to post to your portfolio."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
