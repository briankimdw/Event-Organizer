# Copy to .env.local and fill in from Supabase: Project Settings > API Keys.
# Only the URL and the *publishable* key belong here. Never put the service role / secret key in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The Python service (services/ml) that runs the AI event planner (POST /plan).
# Leave unset to use port 8000 on the same host as the page (works from a phone on the LAN).
VITE_ML_URL=http://localhost:8000
